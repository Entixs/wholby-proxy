# Full URL of your Emby server, no trailing slash needed.
EMBY_URL=http://192.168.1.100:8096

# A UUID that identifies this proxy to clients. Generate one with `uuidgen`. Keep it stable.
PROXY_SERVER_ID=00000000-0000-4000-8000-000000000000

# --- Optional ---
# Port to listen on (default 8096). When using Docker, change the host side of the port mapping instead.
# PORT=8096

# Jellyfin version reported to clients. Wholphin refuses servers older than its SDK's minimum.
# REPORTED_VERSION=10.10.7

# How video streams are delivered:
#   auto     - redirect the client straight to Emby when the client and EMBY_URL use the same protocol
#              (http/https), otherwise stream through this proxy. (default)
#   redirect - always redirect (no proxy bandwidth; clients must reach Emby directly).
#   proxy    - always stream through this proxy (keep Cloudflare "DNS only" if you proxy video).
# STREAM_MODE=auto

# How many items to read from Emby's merged "Continue Watching" list before splitting it into
# Resume and Next Up. Raise it if users have more than 100 in-progress or next-up shows.
# RESUME_FETCH_LIMIT=100

# Where saved sessions are kept, and set DISPLAY_PREFS_FILE to move the preferences file.
# TOKEN_FILE=./data/tokens.json
# DISPLAY_PREFS_FILE=./data/displayprefs.json

# Direct play only (default true): PlaybackInfo always reports direct play, transcode URLs are removed, and HLS /
# non-static stream requests are refused with 403, so Emby never transcodes for these clients.
# Set to false to let Emby transcode when a client asks for it.
# DIRECT_PLAY_ONLY=true

# Log every request (tokens are masked).
# DEBUG=true
